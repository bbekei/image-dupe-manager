# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# PyInstaller build output
dejaview/build/
dejaview/dist/

# Node / Frontend (supplements frontend/.gitignore)
node_modules/
*.tsbuildinfo
.vite/

# OS generated
Thumbs.db
desktop.ini
.DS_Store

# IDE
.vscode/
.idea/

# Temp files
*.tmp

# OAuth / credential files (never commit secrets)
credentials.json
client_secrets.json
*.pem

# Installer output
dejaview/installer/

# E2E test image dataset (generated, large binary set)
dejaview/tests/fixtures/images/e2e_dataset/

# E2E video recordings (Phase 4 local tests)
dejaview/tests-e2e/recordings/*/

# Project management docs (planning iterations)
dejaview/project_management/
project_management/

# Test images
tools/images/