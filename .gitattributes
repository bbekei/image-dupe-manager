# Normalize all text files to LF in the repo, auto-convert to native on checkout.
* text=auto

# Force LF for scripts and source that may run on Unix.
*.py text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.iss text eol=crlf
*.spec text eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.heif binary
*.qm binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.pyc binary
